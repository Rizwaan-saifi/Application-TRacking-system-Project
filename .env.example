# ==============================================================================
# Smart ATS Resume Analyzer - Environment Configuration Example
# Copy this file to .env in 'Backend of Smart ATS NLP-Based Resume Analyzer'
# DO NOT commit real secrets or credentials into version control!
# ==============================================================================

# Database Configuration
# Local SQLite (zero-config local development):
DB_CONNECTION=sqlite:///./ats.db
# PostgreSQL (Production / Docker):
# DB_CONNECTION=postgresql://ats_user:ats_password@localhost:5432/ats_db

# Security & Authentication
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_secure_random_64_character_hex_key
ALGORITHM=HS256
EXP_TIME=60

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: Google Gemini API Key for Tier-3 LLM Resume and JD Extraction
LLM_KEY=your_gemini_api_key_here
